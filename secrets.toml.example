# Salin file ini jadi ".streamlit/secrets.toml" (buang ".example")
# lalu isi API key asli kamu.
#
# File "secrets.toml" (tanpa .example) sudah otomatis di-ignore
# oleh .gitignore -- JANGAN pernah commit file itu ke Git/GitHub.
#
# Untuk deploy di Streamlit Cloud, key ini diisi lewat
# Dashboard App -> Settings -> Secrets, BUKAN lewat file ini.

GEMINI_API_KEY = "isi-api-key-gemini-kamu-di-sini"

# Opsional: memperkuat fallback geocoding NPSN yang koordinat resminya 0,0.
# Jika tidak diisi, fallback tetap memakai validasi ketat OpenStreetMap/Nominatim.
GOOGLE_MAPS_API_KEY = "isi-api-key-google-maps-kamu-di-sini"
